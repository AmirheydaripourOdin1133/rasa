# رسا | RASA — environment template
# Copy to .env.local and fill ONLY when the backend integration is wired.
# The MVP (local/demo mode) reads no environment variables at all.

# ---- Supabase (optional backend) ----
# Project URL from your Supabase dashboard (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key — safe for the browser because RLS protects all tables.
# NEVER put the service-role key here or anywhere client-side.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Landing host routing (optional, for one-service deploys) ----
# Comma-separated domains that should serve the static landing (public/landing/)
# instead of the app at "/". Leave unset for dev/tests/app-only deploys.
# Example: LANDING_HOST=rasa-app.ir,www.rasa-app.ir
LANDING_HOST=

# ---- Notes ----
# - .env.local* files are git-ignored; never commit real keys.
# - Any new variable consumed in client code must be NEXT_PUBLIC_* by design
#   (see docs/security-model.md §6).
