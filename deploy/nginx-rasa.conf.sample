# Nginx reverse proxy for رسا | RASA (Next.js on port 3000)
# Copy to /etc/nginx/sites-available/rasa, replace your-domain.ir, then:
#   sudo ln -s /etc/nginx/sites-available/rasa /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d your-domain.ir   # adds SSL automatically

server {
    listen 80;
    listen [::]:80;
    server_name your-domain.ir www.your-domain.ir;

    # security headers (SSL headers are added by certbot)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # generous size for the PWA shell (small app anyway)
    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # service worker must never be cached by the proxy
    location = /sw.js {
        proxy_pass http://127.0.0.1:3000;
        add_header Cache-Control "no-cache";
    }
}
